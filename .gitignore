# Logs and temp files
logs/
*.log
__pycache__/
*.pyc
.pytest_cache/
*.swp
*.swo
*~

# Build artifacts
build/
install/
devel/
*.egg-info/

# Frontend deps
node_modules/

# Environment / secrets
.env
*.key
*.pem

# OS files
.DS_Store
Thumbs.db

# Large models / recordings (keep structure, not data)
*.mp4
*.bag
*.mkv

# Tokens and credentials
.github_token
*.token
# All .env.* (e.g. .env.opencode) - never commit secrets. Must come before .env
# so the longer match wins for files like .env.opencode.
.env.*
.env.*
.env

# Self-contained workspace copy (heavy, not versioned)
robot_workspace/
