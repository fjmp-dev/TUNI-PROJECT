{
  "name": "mir_suite-dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "runArgs": [
    "--network=host",
    "--privileged",
    "-v", "/dev:/dev"
  ],
  "containerEnv": {
    "ROS_DOMAIN_ID": "75"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "ms-iot.vscode-ros"
      ]
    }
  },
  "shutdownAction": "stopContainer"
}
