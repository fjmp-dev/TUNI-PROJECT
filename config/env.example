# MIR Suite configuration template. Copy to config/.env on the Jetson and fill in.
# config/.env is git-ignored: never commit real values.

# --- Network / robots ---
ROS_DOMAIN_ID=75
MIR_IP=192.168.1.14
LEFT_ARM_IP=192.168.1.102
RIGHT_ARM_IP=192.168.1.103
NORDBO_LEFT_IP=192.168.1.112
NORDBO_RIGHT_IP=192.168.1.113
NORDBO_PORT=2003

# --- Web backend (behind Caddy: bind to loopback) ---
UI_BIND_HOST=127.0.0.1
UI_PORT=8080
TOKEN_TTL=86400
LOGIN_MAX_FAILS=8
LOGIN_LOCKOUT_S=300

# --- Seed account passwords (REQUIRED: replace before first start; used when profiles are first created) ---
AUTH_USER=admin
AUTH_PASS=REPLACE_WITH_A_STRONG_PASSWORD
WAEL_PASS=REPLACE_WITH_A_STRONG_PASSWORD
PABLO_PASS=REPLACE_WITH_A_STRONG_PASSWORD

# --- Web terminal second factor: strong, unique; empty disables the terminal ---
SHELL_PASSWORD=

# --- Arms ---
UR_MAX_DELTA=0.5
UR_STOP_TIMEOUT=10
